# ─── Aplicação ────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Segurança ────────────────────────────────────────────────────────────
# Gere uma chave forte:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=20160
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Banco de dados ───────────────────────────────────────────────────────
# SQLite (padrão, zero configuração):
# DATABASE_URL=sqlite:///./storage/prisma.db
# PostgreSQL / Supabase:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/prisma

# ─── Limites de upload ────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600
MAX_ROWS=2000000
MAX_COLUMNS=512
SAMPLE_ROWS_FOR_ANALYSIS=250000

# ─── Camada de IA ─────────────────────────────────────────────────────────
# auto      → usa Anthropic se houver chave, senão OpenAI, senão modo determinístico
# anthropic → força Anthropic
# openai    → força OpenAI (ou endpoint compatível)
# heuristic → desliga o LLM; a aplicação continua 100% funcional
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=3000
